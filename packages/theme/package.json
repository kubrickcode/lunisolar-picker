{
  "name": "@lunisolar-picker/theme",
  "version": "0.2.0",
  "description": "Mono theme for lunisolar-picker parts",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kubrickcode/lunisolar-picker.git",
    "directory": "packages/theme"
  },
  "homepage": "https://github.com/kubrickcode/lunisolar-picker#readme",
  "bugs": {
